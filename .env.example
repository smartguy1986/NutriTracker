# Database Connection Configuration
# Replace these values with your own Neon Postgres (or any Postgres) connection strings.

# The standard connection string (used by Drizzle and most queries)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# (Optional) For uses requiring a connection without a connection pooler
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Google OAuth Configuration
# Add your Google Client ID here if you want to test Google Login locally
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
